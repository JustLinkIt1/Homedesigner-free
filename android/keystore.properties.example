# Copy to android/keystore.properties and fill in your values.
# Generate a keystore first:
#   keytool -genkey -v -keystore homedesigner-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias homedesigner
storeFile=/absolute/path/to/homedesigner-upload.jks
storePassword=CHANGE_ME
keyAlias=homedesigner
keyPassword=CHANGE_ME
