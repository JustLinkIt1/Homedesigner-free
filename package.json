{
  "name": "homedesigner-free",
  "private": true,
  "version": "1.22.7",
  "license": "UNLICENSED",
  "type": "module",
  "description": "HomeDesigner: draw floor plans in 2D, furnish every room, and walk through your home in 3D. Import PDF/DXF/image plans with automatic wall tracing.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "npm run build && node scripts/assemble-web.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:ci": "node tests/geometry.mjs && node tests/i18n.mjs && node tests/theme.mjs && node tests/models.mjs && node tests/samples.mjs && node tests/billing.mjs",
    "test": "node tests/geometry.mjs && node tests/i18n.mjs && node tests/theme.mjs && node tests/models.mjs && node tests/samples.mjs && node tests/billing.mjs && node tests/trace.mjs && node tests/smoke.mjs",
    "models:trellis": "node scripts/model-catalog/generate-trellis.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "android:aab": "npm run sync-version && npm run build && npx cap sync android && node scripts/run-gradle.mjs bundleRelease && node scripts/verify-aab.mjs",
    "verify-aab": "node scripts/verify-aab.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "listing": "node tools/store-listing.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-app-review": "^8.0.1",
    "@capawesome/capacitor-app-update": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.3.38",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@mlightcad/libredwg-web": "^0.7.8",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/gpu-pathtracer": "^0.3.2",
    "@react-three/postprocessing": "2.19.1",
    "@revenuecat/purchases-capacitor": "^13.4.0",
    "@revenuecat/purchases-js": "^1.48.0",
    "dxf-parser": "^1.1.2",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "konva": "^9.3.16",
    "lucide-react": "^1.21.0",
    "meshoptimizer": "^0.24.0",
    "pdfjs-dist": "^4.7.76",
    "postprocessing": "6.37.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@fal-ai/client": "^1.10.1",
    "@gltf-transform/cli": "^4.4.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "playwright": "^1.61.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.4.9"
  }
}
