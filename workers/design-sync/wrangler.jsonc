{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homedesigner-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "vars": {
    "GOOGLE_WEB_CLIENT_ID": "753361416167-cpdo4k5g15etg79kadcj52h853hf3bqi.apps.googleusercontent.com",
    "REVENUECAT_PROJECT_ID": "proja88f8624"
  },
  "ratelimits": [
    {
      "name": "USER_READ_LIMITER",
      "namespace_id": "11201",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "USER_WRITE_LIMITER",
      "namespace_id": "11202",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "USER_DATA",
      "bucket_name": "homedesigner-user-data"
    }
  ]
}
